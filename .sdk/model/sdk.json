  "main": {
    "kit": {
      "info": {
        "contact": {
          "email": "support@thecolorapi.com"
        },
        "description": "Your fast, modern, swiss army knife for color. Pass in any valid color and get conversion into any other format, the name of the color, placeholder images and a multitude of schemes. Each endpoint is available in JSON[P], HTML & SVG format.",
        "servers": [
          {
            "description": "Production server",
            "url": "https://www.thecolorapi.com"
          }
        ],
        "title": "The Color API",
        "version": "1.0.0",
        "tagline": "Convert any color between formats, look up its name, and generate harmonic schemes",
        "homepage": "https://www.thecolorapi.com",
        "docs_url": "https://www.thecolorapi.com/docs",
        "license_short": "Open source (see github.com/andjosh/thecolorapi); no explicit terms published on the service.",
        "license_md": "- The Color API is described as open source, with source code at [github.com/andjosh/thecolorapi](https://github.com/andjosh/thecolorapi).\n- The public service does not publish an explicit licence, rate limit, or attribution requirement.\n- Check the upstream repository for the canonical licence and any terms before commercial use.",
        "about_md": "[The Color API](https://www.thecolorapi.com) is a small, free HTTP service created by [Josh Beckman](https://github.com/andjosh) that converts colors between formats, identifies the closest named color, and generates harmonic color schemes from a seed color.\n\nWhat you get from the API:\n\n- Color identification via `GET /id` accepting `hex`, `rgb`, `hsl`, or `cmyk` query parameters.\n- Scheme generation via `GET /scheme` with `mode` set to one of `monochrome`, `monochrome-dark`, `monochrome-light`, `analogic`, `analogic-complement`, `complement`, `triad`, or `quad`, plus a `count`.\n- Each color response includes hex, RGB, HSL, HSV, CMYK, and XYZ representations, the nearest named color (drawn from a dataset of around 2000 names) with distance metric, a best-contrast text color, and image URLs.\n- Responses are available as JSON (default), HTML, or SVG via the `format` parameter; SVG and HTML support an optional `w` width and a name-label toggle.\n\nThe service does not document authentication or rate limits, and CORS is reported as enabled. Treat published behaviour as best-effort and consult the GitHub repository for current details.",
        "entity_desc": {
          "idn": "A single identified color resource returned by `GET /id`, carrying hex/RGB/HSL/HSV/CMYK/XYZ values, the closest named color, and a contrast color.",
          "scheme": "A generated palette of colors derived from a seed color via `GET /scheme`, parameterised by `mode` (e.g. `complement`, `triad`, `analogic`) and `count`."
        },
        "auth": false
      },
